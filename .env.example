# ===================================================================
# QC MOBILE OPERATOR - ENVIRONMENT CONFIGURATION (PREVIEW & PRODUCTION)
# ===================================================================

# [OPSIONAL] URL Cloud Backend (misal: Render, Railway, Koyeb)
# Contoh: https://qc-backend-gmp.onrender.com
# Jika dikosongkan, aplikasi dapat langsung masuk lewat "Mode Demo" atau IP Wi-Fi lokal
EXPO_PUBLIC_API_URL=

# [OPSIONAL] Google Gemini API Key (Gratis 1,500 chat/hari dari https://aistudio.google.com)
# Jika dikosongkan, Chatbot AI otomatis menggunakan Offline QC Copilot Engine bawaan pabrik
EXPO_PUBLIC_GEMINI_API_KEY=
